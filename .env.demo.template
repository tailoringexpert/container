DOMAIN=tailoringexpert

# docker
COMPOSE_PROJECT_NAME=tailoringexpert

IMAGE_HOST=localhost:5000
ALPINE_IMAGE=alpine
CURL_IMAGE=${IMAGE_HOST}/arsu/curl
KEYCLOAK_IMAGE=keycloak/keycloak:26.4
MARIADB_IMAGE=mariadb:lts-ubi
LIQUIBASE_IMAGE=liquibase/liquibase:5.0
JAVA_IMAGE=eclipse-temurin:25-jre-ubi10-minimal
APACHE_IMAGE=httpd:trixie

# proxy
TRAEFIK_ENABLE=true
TRAEFIK_NETWORK=proxy
TLS=true
CERTRESOLVER=letsencrypt

# system
SECRETS_HOME=.secrets
DATA_HOME=../data
LOG_HOME=../log
PUID=501
PGID=1000

#catalog
CATALOG_DEMO=9.0.0/catalog.json

# Datenbank
DB_PORT=3306
DATASOURCE_DEFAULT_URL=jdbc:mariadb://db:${DB_PORT}/tailoringexpert
DATASOURCE_DEMO_URL=jdbc:mariadb://db:${DB_PORT}/tailoringexpert_demo

# keycloak
KEYCLOAK_LOG_LEVEL=info
KEYCLOAK_HTTP_ENABLED=true
KEYCLOAK_DB=mariadb
KEYCLOAK_DB_PORT=3306
KEYCLOAK_REALM=tailoringexpert
KEYCLOAK_CLIENT=tailoringexpert
KEYCLOAK_PRODUCTION=false

# app
spring_profiles_active=keycloak
APP_AUTH_PERMIT_ALL=/actuator/**
APP_AGENTLIB=

# web
AUTH_URL=https://${DOMAIN}/auth

# traefik procy
TRAEFIK_DOMAIN=${DOMAIN}
TRAEFIK_NETWORK=proxy
TRAEFIK_DASHBOARD=true
TRAEFIK_ENABLE=true

# secret
